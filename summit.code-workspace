{
    "folders": [
        {
            "name": "summit",
            "path": "."
        },
        {
            "name": "engine",
            "path": "engine"
        },
        {
            "name": "docgen",
            "path": "tools/docgen"
        },
    ],
	"settings": {
        "clangd.fallbackFlags": [
            "-I./engine/vendor/DiligentEngine/install/include",
            "-I./engine/vendor/slang/build/Release/include",
            "-I./engine/src/gpu/glue/diligent",
            "-I./engine/src/gpu/glue/slang"
        ],
        "luau-lsp.platform.type": "standard",
        "luau-lsp.completion.imports.useConst": true,
        "luau-lsp.sourcemap.enabled": false,
        "luau-lsp.types.definitionFiles": { "@types": "./api/types.d.luau" },
        "luau-lsp.ignoreGlobs": [
            "**/vendor/**",
            "**/.clangd-db/**",
            "**/.zig-cache/**",
            "**/zig-pkg/**",
            "**/*.code-search/**"
        ],
        "luau-lsp.completion.imports.ignoreGlobs": [
            "**/vendor/**",
            "**/.clangd-db/**",
            "**/.zig-cache/**",
            "**/zig-pkg/**",
            "**/*.code-search/**",
            "./api/**"
        ],
        "search.exclude": {
            "**/vendor": true,
            "**/.clangd-db": true,
            "**/.zig-cache": true,
            "**/zig-pkg": true,
            "**/*.code-search": true
        },
        "stylua.targetReleaseVersion": "latest",
        "git.ignoreLimitWarning": true
	}
}